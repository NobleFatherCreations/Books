node_modules/

# Raw photos dropped from Google Drive. These are the untouched originals —
# the ingest script reads them and writes optimised copies into
# assets/images/statues/. Keeping them out of git is what keeps the repo small.
incoming/*
!incoming/.gitkeep
!incoming/README.md

# The manifest listing a batch pulled from Google Drive — a workshop
# artifact for the pull, not something the built site reads.
incoming-manifest.json

# Optional local overrides
.env
.env.local
.DS_Store
Thumbs.db
.netlify/

# NOT ignored, deliberately: statues/<id>/, assets/images/social/,
# sitemap.xml and robots.txt are generated by `npm run pages` and MUST be
# committed — Netlify serves them as static files with no build step.
