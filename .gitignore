.audit-view/
__pycache__/
node_modules/
.impeccable/hook.cache.json

# background-agent isolated worktrees (each is its own nested git repo,
# actively in use while an agent is running -- never a real deliverable)
.claude/worktrees/

# scratch Playwright/measurement scripts a subagent wrote to repo root
# instead of the session scratchpad — throwaway, not a deliverable
/audit[0-9]*.js

# The Listening Room's 176 mp3s (~1.26 GB of large binaries), same reasoning as
# the Casting's source photos. They are fully reproducible from the Drive ids in
# deploy/music/MANIFEST.json, which IS committed — see deploy/music/README.md.
deploy/music/audio/
scripts/covers/_work/

# deploy staging dirs, screenshots and throwaway probe scripts written by the
# verify-*.mjs runs. Same reasoning as scripts/covers/_work/ above: an
# intermediate, never a deliverable.
/_work/

# Sacred Divide per-religion PDFs are build output (scripts/sacred-divide-pdf.py --all rebuilds
# all 34 in ~2 minutes); only the reviewed example and the manifest are committed
library/_undeployed/sacred-divide-pdf/*.pdf
!library/_undeployed/sacred-divide-pdf/sunni-islam.pdf
# Expanded editions (scripts/sacred-divide-pdf-expanded.py --all, ~6 minutes for 34): the three
# pages under outside review are committed as examples; the rest rebuild from source
library/_undeployed/sacred-divide-pdf/expanded/*.pdf
!library/_undeployed/sacred-divide-pdf/expanded/sunni-islam-expanded.pdf
!library/_undeployed/sacred-divide-pdf/expanded/judaism-expanded.pdf
!library/_undeployed/sacred-divide-pdf/expanded/catholicism-expanded.pdf
tools/pdf/.build-*.html

# Local preview of the Sacred Divide site (relative links, no visit counter). The live build is
# library/faith/ (scripts/sacred-divide-site.py --base /faith/ --pdf-base /faith/pdf/ --ext "" --live --out library/faith)
library/_undeployed/sacred-divide-redesign/
exports/tiktok-*/
exports/pe/tiktok/
exports/sacred-divide-protestant-evangelical-pdf-and-tiktok.zip
